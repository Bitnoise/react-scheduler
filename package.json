{
  "name": "@code-rhapsodie/react-scheduler",
  "version": "0.6.4",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/code-rhapsodie/react-scheduler"
  },
  "keywords": [
    "scheduler",
    "gantt",
    "gantt chart",
    "react",
    "timeline",
    "calendar"
  ],
  "author": {
    "name": "Bitnoise",
    "url": "https://scheduler.bitnoise.pl/"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "lint": "typescript_eslint_allow_unsupported_typescript_version=true eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "prepare": "husky install"
  },
  "main": "dist/index.cjs",
  "modules": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/index.css": "./dist/index.css",
    "./index.css": "./dist/index.css",
    "./dist/style.css": "./dist/index.css",
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "yarn run lint"
    ]
  },
  "dependencies": {
    "dayjs": "1.11.21",
    "eslint-plugin-import-x": "^4.17.1",
    "lodash.debounce": "4.0.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "10.5.0",
    "@types/lodash.debounce": "4.0.9",
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.9.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup-plugin-visualizer": "7.0.1",
    "styled-components": "6.5.1",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "8.2.1",
    "vite-plugin-svgr": "5.2.0"
  }
}
